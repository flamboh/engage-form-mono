{
	"name": "extension",
	"description": "Canonical Engage Form browser extension.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tsconfig/svelte": "^5.0.8",
		"@wxt-dev/module-svelte": "^2.0.4",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"wxt": "^0.20.26"
	},
	"dependencies": {
		"@clerk/chrome-extension": "^3.1.28",
		"@engage-form/domain": "workspace:*",
		"@engage-form/fill-engine": "workspace:*",
		"convex": "^1.39.1",
		"effect": "^3.21.2"
	},
	"manifest": {
		"key": "$CRX_PUBLIC_KEY",
		"permissions": [
			"cookies",
			"storage"
		],
		"host_permissions": [
			"http://localhost/*",
			"$CLERK_FRONTEND_API/*"
		]
	}
}
