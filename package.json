{
  "name": "engage-form-mono",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run -r test && vp run -r build",
    "dev": "concurrently -n web,convex -c blue,magenta \"vp run web#dev -- --port 3676\" \"bunx convex dev\"",
    "dev:web": "vp run web#dev -- --port 3676",
    "dev:convex": "bunx convex dev",
    "prepare": "vp config"
  },
  "dependencies": {
    "@ikhrustalev/convex-debouncer": "^0.1.2",
    "convex": "^1.36.1",
    "convex-helpers": "^0.1.118"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "concurrently": "^9.2.1",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.13",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  }
}
